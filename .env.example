# Server
PORT=3000
DATABASE_URL=postgresql://bulcoin:bulcoin@localhost:5432/bulcoin

# --- fill manually (see docs/DEPLOY.md) ---
# BOT_TOKEN      → https://t.me/BotFather
# BOT_USERNAME   → BotFather, without @
# ADMIN_TELEGRAM_IDS → https://t.me/userinfobot
# TONAPI_KEY     → https://tonconsole.com
# TONCENTER_API_KEY → https://t.me/tonapibot
# BLC_JETTON_MASTER → your jetton / https://tonviewer.com
# USDT (optional) → https://tonviewer.com/EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs

BOT_TOKEN=your_telegram_bot_token
BOT_USERNAME=your_bot_username
ADMIN_TELEGRAM_IDS=123456789

# --- auto: npm run setup:env ---
WALLET_ENCRYPTION_KEY=change_me_32_char_minimum_secret!!

TON_NETWORK=mainnet
TONAPI_KEY=your_tonapi_io_key
TONCENTER_API_KEY=your_toncenter_api_key
DEDUST_API_URL=https://api-mainnet.dedust.io/v2
CHAIN_WEBHOOK_SECRET=random_webhook_secret
CHAIN_POLL_INTERVAL_SEC=30

BLC_JETTON_MASTER=EQ...
USDT_JETTON_MASTER=EQ...

DEV_MODE=false
DEV_TELEGRAM_USER_ID=999001
DEV_TELEGRAM_USERNAME=devuser

APP_VERSION=1.0.0

# Frontend only (Vercel): URL of API server, e.g. https://api.yourdomain.com
# VITE_API_URL=
